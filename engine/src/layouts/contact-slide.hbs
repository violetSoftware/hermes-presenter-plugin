<div class="content-area contact-slide full-width">{{> header}}<div class="contact-info"><div class="contact-left">{{#if data.name}}<div class="contact-name">{{data.name}}</div>{{/if}}{{#if data.title}}<div class="contact-title">{{data.title}}</div>{{/if}}</div><div class="contact-right">{{#if data.email}}<div class="contact-email">{{data.email}}</div>{{/if}}{{#if data.phone}}<div class="contact-phone">{{data.phone}}</div>{{/if}}</div></div><div class="large-logo"><object type="image/svg+xml" data="{{meta.logo}}" aria-label="{{meta.brand}}"></object></div></div>