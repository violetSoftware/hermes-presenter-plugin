<div class="content-area">{{> header}}{{#if data.title}}<h1>{{data.title}}</h1>{{/if}}{{#if data.subtitle}}<h2>{{data.subtitle}}</h2>{{/if}}<div class="columns-wrapper"><div class="two-column-area" style="flex:0 0 {{contentWidth}}%">{{#if data.text}}<p>{{data.text}}</p>{{/if}}{{#if data.items}}{{> item-list data.items}}{{/if}}</div>{{#if data.image}}<div class="image-area" style="flex:0 0 {{imageWidth}}%"><img src="{{data.image}}" alt="{{data.imageAlt}}"></div>{{/if}}</div>{{> footer}}</div>