{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaultDeck", "decks"],
  "properties": {
    "defaultDeck": {
      "$ref": "#/$defs/deckId"
    },
    "decks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "$ref": "#/$defs/deckId"
          }
        }
      }
    }
  },
  "$defs": {
    "deckId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
