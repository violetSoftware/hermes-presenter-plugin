{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deck.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "language",
    "date",
    "theme",
    "presenter",
    "slides"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "theme": {
      "const": "purple"
    },
    "presenter": {
      "type": "string",
      "minLength": 1
    },
    "website": {
      "type": "string",
      "minLength": 1
    },
    "reveal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 4320
        },
        "transition": {
          "enum": [
            "none",
            "fade",
            "slide",
            "convex",
            "concave",
            "zoom"
          ]
        },
        "controls": {
          "type": "boolean"
        },
        "progress": {
          "type": "boolean"
        },
        "slideNumber": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "runningOrder": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "slideId",
              "role",
              "guidance"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "maxLength": 80
              },
              "slideId": {
                "type": "string",
                "maxLength": 100
              },
              "role": {
                "const": "agent"
              },
              "guidance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "slideId",
              "role",
              "placeholder"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$",
                "maxLength": 80
              },
              "slideId": {
                "type": "string",
                "maxLength": 100
              },
              "role": {
                "const": "human"
              },
              "placeholder": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          }
        ]
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "fragment": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "image": {
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        },
        "backgroundImage": {
          "type": "string"
        },
        "split": {
          "type": "number",
          "minimum": 10,
          "maximum": 90
        },
        "dark": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "data"
      ],
      "properties": {
        "template": {
          "enum": [
            "title-slide",
            "centre-title",
            "two-column",
            "two-column-split",
            "hero-slide",
            "contact-slide"
          ]
        },
        "header": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "presenter": {
              "type": "string"
            },
            "theme": {
              "type": "string"
            }
          }
        },
        "data": {
          "$ref": "#/$defs/data"
        },
        "notes": {
          "type": "string"
        },
        "className": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9 _-]*$"
        }
      }
    }
  }
}
